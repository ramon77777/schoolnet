    "qa:s3a": "node --experimental-strip-types --test scripts/test-schoolnet-s3a-preview-guard.mjs",
    "qa:s3b": "node --experimental-strip-types --test scripts/test-schoolnet-s3b-preview-guard.mjs",
    "qa:s3c": "node --experimental-strip-types --test scripts/test-schoolnet-s3c-preview-guard.mjs",
    "qa:lot5d:a": "node --test scripts/test-schoolnet-lot5d-a-guard.mjs",
    "qa:lot5d:b": "node --experimental-strip-types --test scripts/test-schoolnet-lot5d-b-preflight.mjs",
    "qa:lot5d:c": "node --test scripts/test-schoolnet-lot5d-consolidated-sandbox.mjs",
    "qa:lot5d:d": "node --test scripts/test-schoolnet-lot5d-d-readiness.mjs",
    "qa:lot5d:e": "node --test scripts/test-schoolnet-lot5d-e-legacy-cross.mjs",
    "qa:e2e:readiness": "node --experimental-strip-types --test scripts/test-schoolnet-e2e-readiness.mjs",
    "qa:sandbox:prepare": "node --test scripts/test-schoolnet-sandbox-preparation.mjs",
    "sandbox:check": "node scripts/check-schoolnet-sandbox-env.mjs"
  },
  "dependencies": {
    "@daily-co/daily-js": "^0.94.0",
    "@supabase/supabase-js": "^2.90.1",
    "@tiptap/extension-placeholder": "^3.23.5",
    "@tiptap/extension-text-align": "^3.23.5",
    "@tiptap/react": "^3.23.5",
    "@tiptap/starter-kit": "^3.23.5",
    "katex": "^0.16.47",
    "react": "^19.2.0",
